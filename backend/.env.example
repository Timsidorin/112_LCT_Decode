# Настройки проекта
PROJECT_NAME="Конструктор Тренингов"

# Веб-сервер (в Docker HOST/PORT задаётся в docker-compose)
HOST="0.0.0.0"
PORT=8001
LOG_LEVEL="INFO"

# Аутентификация — обязательно смените в production
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=600000

# База данных (DB_HOST/DB_USER/DB_PASS в Docker переопределяются docker-compose)
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_NAME="timofeymac"
DB_PASS="admin"

# Redis + Celery (в Docker переопределяются docker-compose)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# S3 хранилище
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="your-bucket-name"
S3_ENDPOINT_URL="https://s3.example.com"
S3_REGION_NAME="ru-1"

# AI Video Analysis
AI_API_KEY="your-ai-api-key"
AI_BASE_URL="https://routerai.ru/api/v1"
AI_MODEL="qwen/qwen3-vl-30b-a3b-instruct"
AI_VIDEO_FPS=4
AI_VIDEO_FRAME_OFFSET_SEC="0.10"

# SaluteSpeech TTS (опционально)
CLIENT_ID_SALUTESPEECH=""
SALUT_SPEECH_AUTORIZATION=""

# OAuth Yandex (production — задайте в backend/.env на сервере)
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=https://ai-csis.ru/api/auth/yandex/callback
# FRONTEND_PUBLIC_URL=https://ai-csis.ru
